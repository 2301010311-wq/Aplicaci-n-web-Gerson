# ========================================================================================
# 🔐 SECRET: Datos sensibles de la aplicación (PLANTILLA)
# ========================================================================================
# PROPÓSITO:
#   Este archivo es una PLANTILLA de ejemplo. NO contiene secretos reales.
#
# CÓMO USARLO:
#   1. Copia este archivo a k8s/secret.yaml (ese nombre ya está en .gitignore,
#      así que NUNCA se subirá a git).
#   2. Reemplaza los valores de ejemplo por tus propios secretos codificados en base64:
#        echo -n "mi-password-nuevo" | base64
#   3. Aplica el manifiesto: kubectl apply -f k8s/secret.yaml
#
# ⚠️  SEGURIDAD CRÍTICA:
#     - NUNCA commitees k8s/secret.yaml con valores reales en Git.
#     - Usa contraseñas y JWT_SECRET distintos y aleatorios en cada entorno.
#     - Para producción real, considera HashiCorp Vault o AWS/GCP Secrets Manager
#       en vez de Secrets planos de Kubernetes (que solo están en base64, no encriptados).
# ========================================================================================

apiVersion: v1
kind: Secret
metadata:
  name: app-secret

type: Opaque

data:
  # ========== CREDENCIALES DE BASE DE DATOS (valores de ejemplo, en base64) ==========
  # Genera los tuyos con: echo -n "tu-valor" | base64
  DB_USER: Q0FNQklBTUU=          # "CAMBIAME"
  DB_PASSWORD: Q0FNQklBTUU=      # "CAMBIAME"

  # ========== TOKENS Y CLAVES ==========
  # JWT_SECRET: usa una cadena aleatoria de 32+ caracteres, distinta por entorno.
  # Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
  JWT_SECRET: Q0FNQklBTUU=       # "CAMBIAME"
